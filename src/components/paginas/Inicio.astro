---
import Campo from '../Campo.astro';
import Instagram from '../Instagram.astro';
import { cfg, ehPendente, fmtPeriodo, href, t, txt, visivel, type Lang } from '../../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const g = cfg.grupo;
const coord = g.equipe.find((p: any) => p.id === 'leonardo');
const adjunto = g.equipe.find((p: any) => p.id === 'danilo');
const e = cfg.evento;
const datas = e.datas;
const atalhos = (['sobre', 'evento', 'publicacao', 'historico', 'contato'] as const).filter((c) => visivel(c));
const nomeEvento = ehPendente(e.nome) ? txt(e.nome.pendente.rascunho, lang) || g.sigla : txt(e.nome, lang);
---
<section class="bloco-azul hero" aria-labelledby="titulo-grupo">
  <div class="hero__interno">
    <p class="sobrelinha">{t('home.chamada', lang)} · {txt(g.vinculo, lang)}</p>
    <h1 id="titulo-grupo">{txt(g.nome, lang)}</h1>
    <p class="lide">{txt(g.apresentacao, lang)}</p>
    <dl class="fatos">
      <div><dt>{t('rotulos.temaAnual', lang)}</dt><dd>{txt(g.temaAnual, lang)}</dd></div>
      <div><dt>{t('home.coordenacao', lang)}</dt><dd>{coord.titulo} {coord.nome}</dd></div>
      {adjunto && <div><dt>{t('home.coordenacaoAdjunta', lang)}</dt><dd>{adjunto.titulo} {adjunto.nome}</dd></div>}
    </dl>
    <div class="botoes">
      {visivel('sobre') && <a class="botao" href={href(lang, 'sobre')}>{t('home.conhecer', lang)}</a>}
    </div>
  </div>
</section>

<div class="conteudo">
  <section class="banner-evento" aria-labelledby="titulo-evento">
    <p class="sobrelinha">{t('home.eventoDestaque', lang)}</p>
    <h2 id="titulo-evento">{nomeEvento}</h2>
    {ehPendente(e.nome) && <Campo v={e.nome} lang={lang} />}
    <dl class="dados dados--banner">
      <dt>{t('rotulos.datas', lang)}</dt>
      <dd>{ehPendente(datas) ? <Campo v={datas} lang={lang} /> : fmtPeriodo(datas.inicio, datas.fim, lang)}</dd>
      <dt>{t('rotulos.local', lang)}</dt>
      <dd><Campo v={e.local} lang={lang} /></dd>
      <dt>{t('rotulos.tema', lang)}</dt>
      <dd><Campo v={e.tema} lang={lang} /></dd>
    </dl>
    {visivel('evento') && <p><a class="botao botao--azul" href={href(lang, 'evento')}>{t('home.verEvento', lang)}</a></p>}
  </section>

  <h2>{t('home.linhasTitulo', lang)}</h2>
  <ol class="grade">
    {g.linhas.map((l: any) => (
      <li class="cartao">
        <p class="numero-linha">{lang === 'pt' ? 'Linha' : 'Line'} {String(l.numero).padStart(2, '0')}</p>
        <h3>{txt(l.nome, lang)}</h3>
        <p>{t('rotulos.supervisao', lang)}: {l.supervisao}</p>
      </li>
    ))}
  </ol>
  {visivel('sobre') && <p><a href={href(lang, 'sobre')}>{t('home.verLinhas', lang)}</a></p>}

  <h2>{t('home.secoes', lang)}</h2>
  <ul class="grade">
    {atalhos.map((c) => (
      <li class="cartao">
        <h3><a href={href(lang, c)}>{c === 'evento' ? `${t('nav.evento', lang)} ${e.ano}` : t(`nav.${c}`, lang)}</a></h3>
        <p>{t(`descricoes.${c}`, lang)}</p>
      </li>
    ))}
  </ul>

  <Instagram lang={lang} />
</div>
